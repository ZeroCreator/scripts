# ═══════════════════════════════════════════════════
# scripts environment
# Этот файл должен лежать в scripts/scripts/.env.
# ARMory читает его из каталога, указанного в SCRIPTS_PROJECT_PATHS.
# ═══════════════════════════════════════════════════

# Путь до проекта flat-parser (используется run_remote.sh)
# Используйте абсолютный путь (важен для Docker-контейнера).
FLAT_PARSER_DIR=/home/devel/flat-parser

# SSH-доступ к серверу с flat-parser (если flat-parser на другом сервере).
# Оставьте пустым, если flat-parser работает локально.
FLAT_PARSER_SSH_HOST=devel@10.1.1.10

# ═══════════════════════════════════════════════════
# Scheduler tasks (JSON)
# Пути к скриптам задаются от каталога scripts/scripts/,
# потому что ARMory указывает SCRIPTS_PROJECT_PATHS=~/scripts/scripts.
# Префикс ключа таска в ARMory: scripts:<имя-таска>.
# ═══════════════════════════════════════════════════
SCHEDULER_TASKS='{
  "erz-nashdom":       {"name": "ERZ + Наш.Дом.РФ Литеры + ПД",                    "script": "ssk-scraper/run_erz_nashdom.sh"},
  "trendagent":        {"name": "TrendAgent (ЖК + квартиры + отделка)",            "script": "ssk-scraper/run_trendagent.sh"},
  "trendagent-flats":  {"name": "TrendAgent (только квартиры)",                    "script": "ssk-scraper/run_trendagent_flats.sh"},
  "installments":      {"name": "Рассрочки из Google Sheets",                      "script": "ssk-scraper/run_installments.sh"},
  "prodoma":           {"name": "Отчёты Продома.Дом.РФ",                           "script": "ssk-scraper/run_prodoma.sh"},
  "daily-report":      {"name": "Ежедневный отчёт в Telegram",                     "script": "ssk-scraper/run_daily_report.sh"},
  "dogma":             {"name": "Dogma — парсинг и рассылка XLSX",                 "script": "ssk-scraper/run_dogma.sh"},
  "docker-up":         {"name": "🟢 Docker up (trendagent-worker)",                "script": "ssk-scraper/docker_up.sh"},
  "docker-down":       {"name": "🔴 Docker down (trendagent-worker)",              "script": "ssk-scraper/docker_down.sh"},
  "armory-telegram":   {"name": "📨 ARMory: список задач в Telegram",              "script": "ARMory/send_armory_task_list.py"},
  "start-qwen":        {"name": " QWEN: запуск локального сервера",                "script": "ARMory/start-qwen.sh"},
  "stop-qwen":         {"name": " QWEN: остановка локального сервера",             "script": "ARMory/stop-qwen.sh"}
}'

# Примечание: send_armory_task_list.py формирует сообщение из базы ARMory
# и вызывает send_armory_telegram.sh. Переменные Telegram — в этом же .env.

TELEGRAM_PROXY_URL=
